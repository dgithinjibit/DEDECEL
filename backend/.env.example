# Copy to .env and fill in. The backend runs WITHOUT these (in-memory dev store),
# but for real persistence + a stable hash, set all three.

# Global hashing pepper — a long random secret. REQUIRED for hashing to run.
# Keep this stable forever: changing it invalidates every existing certificate hash.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEDECEL_HASH_PEPPER=

# Supabase project (Project Settings -> API). If unset, the backend uses an in-memory store.
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, never ship to the browser).
SUPABASE_SERVICE_KEY=

# Optional: port the backend listens on (default 4000). On a free host, PORT is injected
# automatically and takes precedence over this.
BACKEND_PORT=4000

# Production CORS allowlist — comma-separated frontend origins allowed to call this API.
# Leave empty for local dev (allows all). Set once the frontend is deployed, e.g.
# CORS_ORIGINS=https://bidecel.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=

# --- NEAR on-chain anchoring (Phase 3) ---------------------------------------
# If NEAR_CONTRACT_ID + signer creds are unset, anchoring is DISABLED: the app
# still runs and /anchor returns a "local:" placeholder id (onChain: false).
# To anchor for real, deploy the contract (see contract/DEPLOY.md) and fill these.
NEAR_NETWORK=testnet
# Account the .wasm is deployed to.
NEAR_CONTRACT_ID=
# The owner account allowed to anchor (often the same as NEAR_CONTRACT_ID).
NEAR_SIGNER_ACCOUNT_ID=
# That owner's PRIVATE key, "ed25519:...". SECRET — server-side only, never the browser.
# Get it with:  near account export-account <acct> using-private-key network-config testnet
NEAR_SIGNER_PRIVATE_KEY=
