# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- BIDECEL Phase 2-5 frontend flags (Vite exposes only VITE_-prefixed vars) --------------
# These are BUILD-TIME vars. On a static host (Vercel/Netlify) set them in the project settings.

# Use the real backend (/api/v1 + /v2) instead of the in-browser mock. Set "true" in production.
VITE_USE_REAL_BACKEND=

# Backend base URL. On Vercel the backend is a serverless function on the SAME domain, so LEAVE
# THIS EMPTY — requests go same-origin (/auth, /v2, /api/v1) and vercel.json rewrites them to /api.
# Only set it if the backend lives on a different host (e.g. https://bidecel-api.onrender.com).
VITE_API_BASE_URL=

# NEAR network the wallet connects to: testnet (default) or mainnet.
VITE_NEAR_NETWORK=testnet
# The deployed contract account. LOGIN only needs it to match the backend's AUTH_RECIPIENT.
# Current live testnet contract: dedecel-sqware.testnet
VITE_NEAR_CONTRACT_ID=dedecel-sqware.testnet
# Optional: free WalletConnect project id (cloud.walletconnect.com) for mobile QR linking.
VITE_WALLETCONNECT_PROJECT_ID=

# NOTE: login is ALWAYS the real NEAR wallet now (NEP-413 signature verified by the backend).
# The old VITE_USE_REAL_WALLET flag + demo stub were removed — there is no junk-login path.
# A read-only "Explore the demo" button exists in the UI for reviewers (no wallet, no writes).

# --- Backend vars — set these in backend/.env for local dev, and in the Vercel dashboard for
#     production (Settings -> Environment Variables). Vercel does NOT read .env files. ---------
# DEDECEL_HASH_PEPPER      secret pepper mixed into every certificate hash (keep secret)
# AUTH_SECRET              long random string used to sign session tokens (keep secret)
# AUTH_RECIPIENT           must equal VITE_NEAR_CONTRACT_ID (what the wallet signs for)
# SUPABASE_URL             your Supabase project URL
# SUPABASE_SERVICE_KEY     Supabase service key (SECRET — rotate at go-live)
# NEAR_NETWORK             testnet | mainnet
# NEAR_CONTRACT_ID         where the anchor contract is deployed
# NEAR_SIGNER_ACCOUNT_ID   the account allowed to anchor (owner)
# NEAR_SIGNER_PRIVATE_KEY  ed25519:... key for that account (blank = anchoring stays placeholder)
# VERIFY_API_KEYS          comma-separated allowlist for the external /verify/v1 API
# CORS_ORIGINS             e.g. https://bidecel.vercel.app (only needed if API is a different host)
# DEDECEL_NO_LISTEN        set to 1 on Vercel (serverless must not bind a port)
