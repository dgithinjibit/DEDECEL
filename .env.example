# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- DEDECEL Phase 2-5 frontend flags (Vite exposes only VITE_-prefixed vars) --------------
# These are BUILD-TIME vars. On a static host (Vercel/Netlify) set them in the project settings.

# Use the real backend (/api/v1 + /v2) instead of the in-browser mock. Set "true" in production.
VITE_USE_REAL_BACKEND=

# Backend base URL for PRODUCTION, e.g. https://dedecel-api.onrender.com
# Leave EMPTY in local dev so relative paths hit the Vite proxy (localhost:4000).
VITE_API_BASE_URL=

# Use the real NEAR wallet-selector for login (opens a modal of every installed NEAR wallet:
# HOT, Meteor, MyNearWallet, Sender, Nightly, Ledger, WalletConnect) instead of the demo stub.
# When "true", login is a real NEP-413 signature verified by the backend — no junk logins.
VITE_USE_REAL_WALLET=
# NEAR network the wallet connects to: testnet (default) or mainnet.
VITE_NEAR_NETWORK=testnet
# The contract account the wallet modal references (see contract/DEPLOY.md). For LOGIN it only
# needs to match the backend's AUTH_RECIPIENT; set the real deployed id once you have one.
VITE_NEAR_CONTRACT_ID=
# Optional: free WalletConnect project id (cloud.walletconnect.com) for mobile QR linking.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Backend wallet-login (NEP-413) vars — set these in backend/.env, NOT here -------------
# AUTH_SECRET        long random string used to sign session tokens (keep secret; rotate freely)
# AUTH_RECIPIENT     must equal VITE_NEAR_CONTRACT_ID above (what the wallet signs for)
# NEAR_NETWORK       testnet | mainnet (used for the on-chain full-access-key check)
